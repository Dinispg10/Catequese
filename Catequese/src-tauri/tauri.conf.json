{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Catequese",
  "version": "0.2.1",
  "identifier": "pt.paroquia.catequese",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Catequese",
        "width": 1280,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNjNFNTc2QUE5MEI1MUMKUldRY3RaQ3FkdVZqVHFwOTVOOUFQUE1yc01BVHBlSmJ1NkF4Z0Y3eitJS0hZdUw5a2FNSmVBOXEK",
      "endpoints": [
        "https://github.com/Dinispg10/Catequese/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
